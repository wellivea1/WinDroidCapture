# Store text consistently; preserve Windows script checkout conventions.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.java text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.ps1 text eol=crlf
*.vcxproj text eol=crlf
*.inf text eol=crlf
*.png binary
*.ico binary
