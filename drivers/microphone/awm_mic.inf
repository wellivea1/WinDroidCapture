[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/12/2026,0.2.0.0
CatalogFile=awm_mic.cat
PnpLockDown=1

[Manufacturer]
%Provider%=AWM,NTamd64.10.0...22000
[AWM.NTamd64.10.0...22000]
%DeviceName%=AWM.Install,Root\AWMPhoneMicrophone

[DestinationDirs]
AWM.Copy=13
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
awm_mic.sys=1
[AWM.Copy]
awm_mic.sys

[AWM.Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=AWM.Copy
AddReg=AWM.Adapter
[AWM.Adapter]
HKR,,AssociatedFilters,0,"wdmaud"
HKR,,Driver,0,"awm_mic.sys"
HKR,Drivers,SubClasses,0,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,0,"wdmaud.drv"
HKR,Drivers\wave\wdmaud.drv,Description,0,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,0,"wdmaud.drv"
HKR,Drivers\mixer\wdmaud.drv,Description,0,%DeviceName%
HKR,MediaCategories\{d3f875c1-9354-4b10-9001-995db5cdcb78},Name,0,%MicrophoneName%

[AWM.Install.NT.Services]
AddService=AWMPhoneMic,0x00000002,AWM.Service
[AWM.Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\awm_mic.sys

[AWM.Install.NT.Interfaces]
AddInterface=%AudioCategory%,"Wave",AWM.Wave
AddInterface=%CaptureCategory%,"Wave",AWM.Wave
AddInterface=%RealtimeCategory%,"Wave",AWM.Wave
AddInterface=%AudioCategory%,"Topology",AWM.Topology
AddInterface=%TopologyCategory%,"Topology",AWM.Topology
[AWM.Wave]
AddReg=AWM.Wave.Settings
[AWM.Wave.Settings]
HKR,,CLSID,0,%ProxyClsid%
HKR,,FriendlyName,0,%MicrophoneName%
[AWM.Topology]
AddReg=AWM.Topology.Settings
[AWM.Topology.Settings]
HKR,,CLSID,0,%ProxyClsid%
HKR,,FriendlyName,0,%MicrophoneName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,0,%MicrophoneNode%
HKR,EP\0,%PKEY_AudioEndpoint_FormFactor%,0x00010001,4
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1
HKR,EP\0,%PKEY_Device_FriendlyName%,0,%MicrophoneName%

